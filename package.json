{
  "name": "pizzaparty-companion-app",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "functions"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "check": "npm run controlla-temi && tsc -p tests && tsc -p functions --noEmit && npm run check -w web",
    "preview": "npm run preview -w web",
    "emulatori": "npm run build -w functions && sh scripts/emulatori.sh",
    "icone": "node scripts/icone.mjs",
    "controlla-temi": "node scripts/controlla-temi.mjs",
    "formatta": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "npm run test -w web && npm run test -w functions",
    "test:e2e": "npm run test:e2e -w web",
    "test:regole": "sh scripts/emulatori.sh test",
    "controlla-versione": "node scripts/controlla-versione.mjs",
    "build:functions": "npm run build -w functions"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "firebase": "^12.19.0",
    "firebase-tools": "15.31.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "^8.71.0"
  }
}
