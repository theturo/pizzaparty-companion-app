#!/bin/sh
# Controlli prima di ogni commit nella repo PUBBLICA.
# Si attiva una volta per clone con: git config core.hooksPath .githooks

# 1. Autore con l'email noreply di GitHub, mai quella personale (D-018).
email=$(git config user.email)
case "$email" in
  *@users.noreply.github.com) ;;
  *)
    echo "✋ Email dell'autore non consentita: $email"
    echo "   Usa l'email noreply di GitHub: git config user.email <id>+<utente>@users.noreply.github.com"
    exit 1
    ;;
esac

# 2. Formattazione automatica dei file in commit (Prettier).
#    Si formattano solo i file interamente in commit: se un file ha anche modifiche
#    non aggiunte, lo si lascia com'è (lo segnalerà la CI) per non aggiungerle per errore.
in_commit=$(git diff --cached --name-only --diff-filter=ACMR)
non_aggiunti=$(git diff --name-only)
da_formattare=""
for f in $in_commit; do
  case "$f" in
    *.ts|*.js|*.mjs|*.svelte|*.css|*.json|*.md|*.yml|*.yaml|*.html) ;;
    *) continue ;;
  esac
  if echo "$non_aggiunti" | grep -qx "$f"; then
    echo "ℹ️  $f ha modifiche non aggiunte: non lo formatto (npm run formatta)."
  else
    da_formattare="$da_formattare $f"
  fi
done
if [ -n "$da_formattare" ]; then
  # shellcheck disable=SC2086
  npx --no-install prettier --write --ignore-unknown --log-level warn $da_formattare && git add $da_formattare
fi

# 3. Nessun segreto o dato personale nei file in commit.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✋ gitleaks non installato (brew install gitleaks): commit bloccato per sicurezza."
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner || {
  echo "✋ gitleaks ha trovato possibili segreti o dati personali: commit bloccato."
  exit 1
}
