rules_version = '2';

// Regole di sicurezza di Firestore: il vero confine di sicurezza dell'app.
// Tutto è chiuso, tranne ciò che è aperto qui sotto; ogni apertura ha i suoi test (tests/regole/).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Funzioni di supporto ----
    function connesso() {
      return request.auth != null;
    }
    function eLaPersona(uid) {
      return connesso() && request.auth.uid == uid;
    }
    function emailVerificata() {
      return request.auth.token.email_verified == true;
    }
    // Permessi speciali sul token, assegnati solo dalle Cloud Functions (D-034).
    function admin() {
      return connesso() && request.auth.token.admin == true;
    }
    function approvato() {
      return connesso() && request.auth.token.approvato == true;
    }
    // Stesso elenco di web/src/lib/account/avatar.ts (un test controlla che coincidano).
    function avatarValido(avatar) {
      return avatar in ['margherita', 'diavola', 'fetta', 'peperoncino', 'basilico', 'pomodoro', 'forno', 'chef', 'pala', 'funghi', 'birra', 'fiamma'];
    }
    function nomeValido(nome) {
      return nome is string && nome.size() >= 2 && nome.size() <= 40 && nome.trim() == nome;
    }
    function invitoValido(invito) {
      return invito is map
        && invito.keys().hasOnly(['codice', 'testo']) && invito.keys().hasAll(['codice', 'testo'])
        && (invito.codice == null || (invito.codice is string && invito.codice.matches('^[a-zA-Z0-9-]{4,32}$')))
        && (invito.testo == null || (invito.testo is string && invito.testo.size() >= 1 && invito.testo.size() <= 80))
        && !(invito.codice != null && invito.testo != null);
    }
    function accettazioniValide(acc) {
      return acc is map
        && acc.keys().hasOnly(['maggiorenne', 'condizioni', 'privacy', 'il'])
        && acc.keys().hasAll(['maggiorenne', 'condizioni', 'privacy', 'il'])
        && acc.maggiorenne == true
        && acc.condizioni is string && acc.condizioni.size() <= 20
        && acc.privacy is string && acc.privacy.size() <= 20
        && acc.il == request.time;
    }

    // ---- Profili (D-024, D-025, D-031) ----
    // L'email non si salva qui: resta in Authentication (minimizzazione).
    match /utenti/{uid} {
      // Profilo privato: lo vedono solo la persona e l'admin. Degli altri si vede "profili/{uid}".
      allow read: if eLaPersona(uid) || admin();

      // Si crea una volta sola, dopo aver verificato l'email, sempre "in attesa".
      allow create: if eLaPersona(uid) && emailVerificata()
        && request.resource.data.keys().hasOnly(['nome', 'avatar', 'stato', 'invitatoDa', 'accettazioni', 'creato'])
        && request.resource.data.keys().hasAll(['nome', 'avatar', 'stato', 'invitatoDa', 'accettazioni', 'creato'])
        && nomeValido(request.resource.data.nome)
        && avatarValido(request.resource.data.avatar)
        && request.resource.data.stato == 'in_attesa'
        && invitoValido(request.resource.data.invitatoDa)
        && accettazioniValide(request.resource.data.accettazioni)
        && request.resource.data.creato == request.time;

      // La persona può cambiare solo nome e avatar; stato, invito e approvazione li scrivono le Functions.
      allow update: if eLaPersona(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'avatar'])
        && nomeValido(request.resource.data.nome)
        && avatarValido(request.resource.data.avatar);

      // La cancellazione dell'account passa da una funzione sul server (1.3).
      allow delete: if false;

      // Dispositivi con le notifiche attive (D-036): l'id è il codice del dispositivo.
      // Solo la persona li registra e li toglie; li legge e li usa il server per inviare.
      match /dispositivi/{codice} {
        allow read, delete: if eLaPersona(uid);
        allow create: if eLaPersona(uid)
          && codice.size() <= 400
          && request.resource.data.keys().hasOnly(['piattaforma', 'creato'])
          && request.resource.data.keys().hasAll(['piattaforma', 'creato'])
          && request.resource.data.piattaforma is string
          && request.resource.data.piattaforma.size() <= 40
          && request.resource.data.creato == request.time;
        allow update: if false;
      }
    }

    // ---- Schede pubbliche: nome e avatar, visibili tra approvati (D-033) ----
    match /profili/{uid} {
      allow read: if approvato() || admin();
      allow write: if false;
    }

    // ---- Richieste in attesa, con l'email: solo per l'admin (D-034) ----
    match /richieste/{uid} {
      allow read: if admin();
      allow write: if false;
    }

    // ---- Codici d'invito: li leggono e scrivono solo le Functions ----
    match /inviti/{codice} {
      allow read, write: if false;
    }

    // ---- Edizioni (D-053): le scrive e le legge tutte solo l'admin; gli approvati leggono
    // solo quelle pubblicate (annunciata, conclusa, annullata). Le bozze restano all'admin. ----
    function nomeEdizione(nome) {
      return nome is string && nome.size() >= 2 && nome.size() <= 60 && nome.trim() == nome;
    }
    function quandoEdizione(q) {
      return q is map && (
        (q.tipo == 'data'
          && q.keys().hasOnly(['tipo', 'data']) && q.keys().hasAll(['tipo', 'data'])
          && q.data is string && q.data.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'))
        || (q.tipo == 'periodo'
          && q.keys().hasOnly(['tipo', 'periodo']) && q.keys().hasAll(['tipo', 'periodo'])
          && q.periodo is string && q.periodo.size() >= 2 && q.periodo.size() <= 40)
      );
    }
    function quotaEdizione(q) {
      return q is map
        && q.keys().hasOnly(['singolo', 'conAccompagnatore'])
        && q.keys().hasAll(['singolo', 'conAccompagnatore'])
        && q.singolo is int && q.singolo >= 0 && q.singolo <= 100
        && q.conAccompagnatore is int && q.conAccompagnatore >= 0 && q.conAccompagnatore <= 100;
    }
    function pagamentiEdizione(p) {
      return p is map
        && p.keys().hasOnly(['paypal', 'satispay', 'contanti'])
        && p.keys().hasAll(['paypal', 'satispay', 'contanti'])
        && p.paypal is bool && p.satispay is bool && p.contanti is bool;
    }
    function edizioneValida(d) {
      return d is map
        && d.keys().hasOnly(['nome', 'quando', 'tema', 'quota', 'pagamenti', 'stato', 'creato', 'aggiornato'])
        && d.keys().hasAll(['nome', 'quando', 'tema', 'quota', 'pagamenti', 'stato', 'creato', 'aggiornato'])
        && nomeEdizione(d.nome)
        && quandoEdizione(d.quando)
        && d.tema is string && d.tema.matches('^[a-z0-9-]{1,40}$')
        && quotaEdizione(d.quota)
        && pagamentiEdizione(d.pagamenti)
        && d.stato in ['bozza', 'annunciata', 'conclusa', 'annullata']
        && d.aggiornato == request.time;
    }

    match /edizioni/{id} {
      allow read: if admin()
        || (approvato() && resource.data.stato in ['annunciata', 'conclusa', 'annullata']);
      allow create: if admin()
        && edizioneValida(request.resource.data)
        && request.resource.data.creato == request.time;
      allow update: if admin()
        && edizioneValida(request.resource.data)
        && request.resource.data.creato == resource.data.creato;
      allow delete: if false;
    }

    // ---- Link di pagamento, uguali per tutte le edizioni (D-055): solo l'admin ----
    match /impostazioni/pagamenti {
      function linkValido(l) {
        return l is string && (l == '' || (l.size() <= 300 && l.matches('^https://.+')));
      }
      allow read: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['paypal', 'satispay', 'aggiornato'])
        && request.resource.data.keys().hasAll(['paypal', 'satispay', 'aggiornato'])
        && linkValido(request.resource.data.paypal)
        && linkValido(request.resource.data.satispay)
        && request.resource.data.aggiornato == request.time;
      allow delete: if false;
    }

    // ---- Tutto il resto: chiuso ----
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
